{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/e2e.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "playwright.docs.config.ts",
    "tests/e2e/**/*",
    "tests/docs/**/*",
    "src/env.d.ts",
    "src/shared/**/*",
    "src/preload/types.ts",
    "src/preload/global.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
